{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "kavenegar/laravel": "^1.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "league/flysystem-ftp": "3.0",
        "maatwebsite/excel": "^3.1.69",
        "morilog/jalali": "3.*",
        "pion/laravel-chunk-upload": "^1.6",
        "predis/predis": "^2.2",
        "psr/simple-cache": "^3.0",
        "sadegh19b/laravel-persian-validation": "^2.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-permission": "^6.25"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.65",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:coverage": [
            "@php -r \"is_dir('coverage') || mkdir('coverage', 0777, true);\"",
            "@php -d memory_limit=1G vendor/bin/phpunit --coverage-clover=coverage/clover.xml --coverage-text=coverage/coverage.txt --coverage-cobertura=coverage/cobertura.xml",
            "@php scripts/check-coverage.php coverage/clover.xml 98"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
