APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Production / Dokploy (docker-compose.yml): same MySQL as the microservices stack.
# DB_HOST=metarang-mysql
# DB_DATABASE=metarang_db
# DB_USERNAME=metarang_user
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Dokploy host bind mounts (docker-compose.yml). Defaults match Dokploy ../files/:
# HOST_STORAGE_PATH=../files/storage
# HOST_DATABASE_PATH=../files/database
# Local smoke test (no Dokploy files/ tree):
# HOST_STORAGE_PATH=./storage
# HOST_DATABASE_PATH=./database
# Production MySQL is the microservices instance (hostname metarang-mysql on metarang-shared).
# Local docker-compose.dev.yaml still uses its own mysql service (DB_HOST=mysql).

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

SENTRY_LARAVEL_DSN=https://fbc0bb81b6fbcc6b8dcead79e099eca2@sentry.irpsc.com/11
SENTRY_TRACES_SAMPLE_RATE=0.1
# Structured Logs UI is often unavailable on self-hosted Sentry; keep false unless Logs is enabled server-side.
SENTRY_ENABLE_LOGS=false
SENTRY_SEND_DEFAULT_PII=false
